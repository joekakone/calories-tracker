<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_splash">

    <fragment
        android:id="@+id/navigation_splash"
        android:name="com.example.caloriestracker.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/navigation_splash"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/navigation_dashboard"
            app:popUpTo="@id/navigation_splash"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.example.caloriestracker.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/navigation_register" />
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/navigation_dashboard"
            app:popUpTo="@id/navigation_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_register"
        android:name="com.example.caloriestracker.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/navigation_register"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_dashboard"
            app:destination="@id/navigation_dashboard"
            app:popUpTo="@id/navigation_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.caloriestracker.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_notifications"
            app:destination="@id/navigation_notifications" />
    </fragment>

    <fragment
        android:id="@+id/navigation_historique"
        android:name="com.example.caloriestracker.HistoriqueFragment"
        android:label="Historique"
        tools:layout="@layout/fragment_historique">
        <action
            android:id="@+id/action_historique_to_detail"
            app:destination="@id/navigation_meal_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_exercices"
        android:name="com.example.caloriestracker.ExercicesFragment"
        android:label="Exercices"
        tools:layout="@layout/fragment_exercices">
        <action
            android:id="@+id/action_exercices_to_workout_map"
            app:destination="@id/navigation_workout_map" />
        <action
            android:id="@+id/action_exercices_to_workout_details"
            app:destination="@id/workoutDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profil"
        android:name="com.example.caloriestracker.ProfilFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profil">
        <action
            android:id="@+id/action_profil_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/navigation_dashboard"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_scanner"
        android:name="com.example.caloriestracker.ScannerFragment"
        android:label="Scanner"
        tools:layout="@layout/fragment_scanner">
        <action
            android:id="@+id/action_scanner_to_meal_summary"
            app:destination="@id/navigation_meal_summary" />
    </fragment>
    
    <fragment
        android:id="@+id/navigation_meal_summary"
        android:name="com.example.caloriestracker.MealSummaryFragment"
        android:label="Meal Summary"
        tools:layout="@layout/fragment_meal_summary">
        <argument
            android:name="imageUri"
            app:argType="string" />
        <action
            android:id="@+id/action_summary_to_dashboard"
            app:destination="@id/navigation_dashboard"
            app:popUpTo="@id/navigation_dashboard"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_summary_to_detail"
            app:destination="@id/navigation_meal_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_meal_detail"
        android:name="com.example.caloriestracker.MealDetailFragment"
        android:label="Meal Detail"
        tools:layout="@layout/fragment_meal_detail">
        <argument
            android:name="mealId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.caloriestracker.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_workout_map"
        android:name="com.example.caloriestracker.WorkoutMapFragment"
        android:label="Workout Map"
        tools:layout="@layout/fragment_workout_map">
        <argument
            android:name="workoutType"
            app:argType="string"
            android:defaultValue="Marche" />
    </fragment>

    <fragment
        android:id="@+id/workoutDetailsFragment"
        android:name="com.example.caloriestracker.WorkoutDetailsFragment"
        android:label="Workout Details"
        tools:layout="@layout/fragment_workout_details">
        <argument
            android:name="workoutId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

</navigation>
