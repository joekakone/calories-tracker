<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_color"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:paddingTop="32dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bonjour, Joe"
            android:textColor="@color/text_title"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12 sept. 2026"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_notification"
            app:tint="@color/primary_green"
            app:layout_constraintEnd_toStartOf="@+id/cvAvatar"
            app:layout_constraintTop_toTopOf="@+id/cvAvatar"
            app:layout_constraintBottom_toBottomOf="@+id/cvAvatar" />

        <TextView
            android:id="@+id/tvNotificationBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_notification_badge"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toTopOf="@id/ivNotification"
            app:layout_constraintEnd_toEndOf="@id/ivNotification"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvDate">
            <ImageView
                android:id="@+id/ivAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="JK"
                android:textColor="@color/primary_blue"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />
        </androidx.cardview.widget.CardView>

        <!-- 4 Metrics Cards using GridLayout -->
        <GridLayout
            android:id="@+id/gridMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2"
            android:rowCount="2"
            app:layout_constraintTop_toBottomOf="@id/tvDate">

            <!-- Card 1: Calories Consommées -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvCard1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cal. Consommées"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvCard1Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1 850"
                    android:textSize="24sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCard1Title"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" kcal"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvCard1Value"
                    app:layout_constraintStart_toEndOf="@id/tvCard1Value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 2: Calories Dépensées -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvCard2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cal. Dépensées"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvCard2Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="420"
                    android:textSize="24sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCard2Title"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" kcal"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvCard2Value"
                    app:layout_constraintStart_toEndOf="@id/tvCard2Value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 3: Eau -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvCard3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eau absorbée"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvCard3Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1.8"
                    android:textSize="24sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCard3Title"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" L"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvCard3Value"
                    app:layout_constraintStart_toEndOf="@id/tvCard3Value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 4: Pas -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvCard4Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre de Pas"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvCard4Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="6 420"
                    android:textSize="24sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCard4Title"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" pas"
                    android:textSize="12sp"
                    android:textColor="@color/text_subtitle"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvCard4Value"
                    app:layout_constraintStart_toEndOf="@id/tvCard4Value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </GridLayout>

        <!-- Progress and Macros -->
        <TextView
            android:id="@+id/tvProgressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Calories consommées"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridMetrics" />

        <TextView
            android:id="@+id/tvProgressDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reste : 18500 kcal"
            android:textColor="@color/text_subtitle"
            android:textSize="12sp"
            android:fontFamily="@font/poppins"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProgressTitle" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75%"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tvProgressDesc" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progress="75"
            android:progressTint="@color/primary_green"
            android:backgroundTint="@color/divider_color"
            app:layout_constraintTop_toBottomOf="@id/tvProgressDesc" />

        <!-- Macro Pills (Ordered: Protein(Green), Carbs(Blue), Fat(Orange)) -->
        <LinearLayout
            android:id="@+id/llMacros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/progressBar">

            <!-- Carbs (Blue) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/macro_carbs"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glucides"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />
                <TextView
                    android:id="@+id/tvCarbsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="180g"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>

            <!-- Protein (Green) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/macro_protein"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protéines"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />
                <TextView
                    android:id="@+id/tvProteinBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="110g"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>

            <!-- Fat (Orange) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/macro_fat"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lipides"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />
                <TextView
                    android:id="@+id/tvFatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="55g"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chart Placeholder -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/llMacros">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <!-- Legend -->
                <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:gravity="center"
                   android:orientation="horizontal">
                   <View android:layout_width="8dp" android:layout_height="8dp" android:background="@color/primary_green" android:layout_marginEnd="8dp"/>
                   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calories consommées" android:textSize="12sp" android:fontFamily="@font/poppins" android:textColor="@color/text_subtitle" android:layout_marginEnd="16dp"/>
                   <View android:layout_width="8dp" android:layout_height="8dp" android:background="@color/danger_text" android:layout_marginEnd="8dp"/>
                   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calories dépensées" android:textSize="12sp" android:fontFamily="@font/poppins" android:textColor="@color/text_subtitle"/>
                </LinearLayout>
                
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Activités Récentes -->
        <TextView
            android:id="@+id/tvRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Activités récentes"
            android:textColor="@color/text_title"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvChart" />

        <LinearLayout
            android:id="@+id/llRecentActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvRecentTitle">
            
            <!-- Activities will be populated dynamically -->

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintTop_toBottomOf="@id/llRecentActivities" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
